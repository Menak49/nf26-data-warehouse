@startuml SOC_Socle



entity "R_PART" {
  * PART_ID : INTEGER <<PK>>
  --
  SRC_ID : INTEGER
  SRC_TYP : VARCHAR(50)
}

entity "R_ROOM" {
  * ROOM_NUM : INTEGER <<PK>>
  --
  ROOM_NAME : VARCHAR(20)
  FLOR_NUM : BYTEINT
  BULD_NAME : VARCHAR(20)
  ROOM_TYP : VARCHAR(10) (NULL)
  ROOM_DAY_RATE : SMALLINT
  CRTN_DT : DATE
  EXEC_ID : CHAR(36) <<FK>>

}

entity "R_MEDC" {
  * MEDC_ID : INTEGER <<PK>>
  --
  MEDC_CD : VARCHAR(10)
  MEDC_NAME : VARCHAR(250) (NULL)
  MEDC_COND : VARCHAR(100) (NULL)
  MEDC_CATG : VARCHAR(100)
  MANF_BRND : VARCHAR(100)
  EXEC_ID : CHAR(36) <<FK>>
}

entity "O_INDV" {
  * PART_ID : INTEGER <<PK, FK>>
  --
  INDV_NAME : VARCHAR(100)
  INDV_FIRS_NAME : VARCHAR(100)
  INDV_STTS_CD : VARCHAR(10)
  CRTN_DTTM : TIMESTAMP(0)
  UPDT_DTTM : TIMESTAMP(0)
  BIRT_DT : DATE (NULL)
  BIRT_CITY : VARCHAR(100) (NULL)
  BIRT_CNTR : VARCHAR(100) (NULL)
  SOCL_NUM : VARCHAR(15) (NULL)
  EXEC_ID : CHAR(36) <<FK>>
}

entity "O_STFF" {
  * PART_ID : INTEGER <<PK, FK>>
  --
  WORK_STRT_DTTM : TIMESTAMP(0)
  WORK_END_DTTM : TIMESTAMP(0) (NULL)
  WORK_END_RESN : VARCHAR(100) (NULL)
  EXEC_ID : CHAR(36) <<FK>>
}

entity "O_TELP" {
  * PART_ID : INTEGER <<PK, FK>>
  * STRT_VALD_DTTM : TIMESTAMP(0) <<PK>>
  --
  CNTR_IND : VARCHAR(5) (NULL)
  TELP_NUM : VARCHAR(20)
  END_VALD_DTTM : TIMESTAMP(0)
  EXEC_ID : CHAR(36) <<FK>>
}

entity "O_ADDR" {
  * PART_ID : INTEGER <<PK, FK>>
  * STRT_VALD_DTTM : TIMESTAMP(0) <<PK>>
  --
  STRT_NUM : VARCHAR(10)
  STRT_DSC : VARCHAR(250)
  COMP_STRT : VARCHAR(250) (NULL)
  POST_CD : VARCHAR(10)
  CITY_NAME : VARCHAR(100) (NULL)
  CNTR_NAME : VARCHAR(100) (NULL)
  END_VALD_DTTM : TIMESTAMP(0)
  EXEC_ID : CHAR(36) <<FK>>
}

entity "O_TRET" {
  * TRET_ID : INTEGER <<PK>>
  --
  MEDC_ID : INTEGER <<FK>> (NULL)
  MEDC_QTY : SMALLINT (NULL)
  DOSG_DSC : VARCHAR(100)
  CONS_ID : INTEGER <<FK>>
  TRET_CRTN_DTTM : TIMESTAMP(0)
  EXEC_ID : CHAR(36) <<FK>>
}

entity "O_CONS" {
  * CONS_ID : INTEGER <<PK>>
  --
  STFF_ID : INTEGER <<FK>>
  PATN_ID : INTEGER <<FK>>
  CONS_STRT_DTTM : TIMESTAMP(0)
  CONS_END_DTTM : TIMESTAMP(0)
  PATN_WEGH : INTEGER
  PATN_TEMP : INTEGER (NULL)
  TEMP_UNIT : VARCHAR(15) (NULL)
  BLD_PRSS : INTEGER (NULL)
  PATH_DSC : VARCHAR(250) (NULL)
  DIBT_IND : BYTEINT (NULL)
  TRET_ID : TIMESTAMP(0) <<FK>>
  HOSP_IND : BYTEINT
  EXEC_ID : CHAR(36) <<FK>>
}

entity "O_HOSP" {
  * HOSP_ID : INTEGER <<PK>>
  --
  CONS_ID : INTEGER <<FK>>
  ROOM_NUM : INTEGER <<FK>>
  HOSP_STRT_DTTM : TIMESTAMP(0)
  HOSP_END_DTTM : TIMESTAMP(0)
  HOSP_FINL_RATE : INTEGER
  STFF_ID : INTEGER <<FK>>
  EXEC_ID : CHAR(36) <<FK>>
}

entity "T_SUIV_RUN" {
  * EXEC_ID : CHAR(36) <<PK>>
  --
  RUN_STRT_DTTM : TIMESTAMP(0)
  RUN_END_DTTM : TIMESTAMP(0) (NULL)
  RUN_STTS_CD : VARCHAR(10)
}

entity "T_SUIV_TRMT" {
  * EXEC_ID : CHAR(36) <<PK>>
  --
  SCRPT_NAME : VARCHAR(250)
  EXEC_STRT_DTTM : TIMESTAMP(0)
  EXEC_END_DTTM : TIMESTAMP(0) (NULL)
  EXEC_STTS_CD : VARCHAR(10)
}

' ── R_PART vers sous-tables ──────────────────────────
R_PART -- O_INDV  : PART_ID
R_PART -- O_STFF  : PART_ID
R_PART -- O_TELP  : PART_ID
R_PART -- O_ADDR  : PART_ID

' ── R_MEDC vers O_TRET ───────────────────────────────
R_MEDC -- O_TRET  : MEDC_ID

' ── O_CONS vers O_TRET (double lien) ─────────────────
O_CONS -- O_TRET  : CONS_ID
O_CONS -- O_TRET : TRET_ID

' ── O_STFF / O_INDV vers O_CONS ──────────────────────
O_STFF -- O_CONS  : STFF_ID
O_INDV -- O_CONS  : PATN_ID

' ── O_CONS vers O_HOSP ───────────────────────────────
O_CONS -- O_HOSP  : CONS_ID

' ── R_ROOM / O_STFF vers O_HOSP ──────────────────────
R_ROOM -- O_HOSP  : ROOM_NUM
O_STFF -- O_HOSP  : STFF_ID

' ── TCH : run -> trmt ────────────────────────────────
T_SUIV_RUN -- T_SUIV_TRMT : RUN_ID

' ── EXEC_ID FK dans toutes les tables métier ─────────
T_SUIV_TRMT "1" -- "0..*" R_ROOM  : EXEC_ID
T_SUIV_TRMT "1" -- "0..*" R_MEDC  : EXEC_ID
T_SUIV_TRMT "1" -- "0..*" O_INDV  : EXEC_ID
T_SUIV_TRMT "1" -- "0..*" O_STFF  : EXEC_ID
T_SUIV_TRMT "1" -- "0..*" O_TELP  : EXEC_ID
T_SUIV_TRMT "1" -- "0..*" O_ADDR  : EXEC_ID
T_SUIV_TRMT "1" -- "0..*" O_TRET  : EXEC_ID
T_SUIV_TRMT "1" -- "0..*" O_CONS  : EXEC_ID
T_SUIV_TRMT "1" -- "0..*" O_HOSP  : EXEC_ID

@enduml